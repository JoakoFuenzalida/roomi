generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ USUARIOS Y HOGARES ============

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String?
  name           String
  image          String?
  createdAt      DateTime @default(now())

  memberships     Membership[]
  taskExecutions  TaskExecution[]
  pushSubs        PushSubscription[]
  itemsCreated    ShoppingItem[]   @relation("itemCreator")
  itemsChecked    ShoppingItem[]   @relation("itemChecker")
  paidExpenses    Expense[]        @relation("payer")
  expenseSplits   ExpenseSplit[]
  settlementsSent Settlement[]     @relation("settleFrom")
  settlementsRcvd Settlement[]     @relation("settleTo")
  settlementsMade Settlement[]     @relation("settleRecorder")
  billsCreated    MonthlyBill[]    @relation("billCreator")
  monthlyCharges  MonthlyCharge[]  @relation("chargeOwner")
  chargesConfirmed MonthlyCharge[] @relation("chargeConfirmer")
  billSplitsConfirmed BillItemSplit[] @relation("billSplitConfirmer")
  noticesAuthored Notice[]         @relation("noticeAuthor")
  reactions       Reaction[]
  billItemSplits  BillItemSplit[]
}

model Household {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique @default(cuid())
  createdAt  DateTime @default(now())

  members       Membership[]
  tasks         Task[]
  shoppingItems ShoppingItem[]
  expenses      Expense[]
  settlements   Settlement[]
  rooms         Room[]
  monthlyBills  MonthlyBill[]
  notices       Notice[]
}

enum HouseholdRole {
  ADMIN
  MEMBER
}

model Membership {
  id              String        @id @default(cuid())
  userId          String
  householdId     String
  role            HouseholdRole @default(MEMBER)
  rotationOrder   Int
  onVacationUntil DateTime?
  chatMuted       Boolean       @default(false)
  joinedAt        DateTime      @default(now())
  leftAt          DateTime?

  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  household        Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  assignedTasks    Task[]         @relation("nextAssignee")
  taskParticipations TaskParticipant[]
  nextShoppingFor  ShoppingItem[] @relation("nextBuyer")
  room             Room?

  @@unique([userId, householdId])
  @@index([householdId, leftAt, rotationOrder])
}

// ============ TAREAS + ROTACIÓN ============

enum TaskFrequency {
  ONCE
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
}

model Task {
  id          String        @id @default(cuid())
  householdId String
  title       String
  frequency   TaskFrequency
  points      Int           @default(1)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  daysOfWeek  Int[] @default([]) // 0-6 (0=domingo), para WEEKLY / BIWEEKLY. Vacío = 1 vez por período.
  daysOfMonth Int[] @default([]) // 1-31, para MONTHLY. Vacío = 1 vez por período.

  nextAssigneeMembershipId String?
  nextDueDate              DateTime
  cycleNumber              Int      @default(0)

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  nextAssignee Membership?     @relation("nextAssignee", fields: [nextAssigneeMembershipId], references: [id])
  executions   TaskExecution[]
  participants TaskParticipant[]

  @@index([householdId, active, nextDueDate])
}

model TaskParticipant {
  id           String @id @default(cuid())
  taskId       String
  membershipId String
  order        Int

  task       Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([taskId, membershipId])
  @@index([taskId, order])
}

model TaskExecution {
  id            String   @id @default(cuid())
  taskId        String
  completedById String
  cycleNumber   Int
  wasAssigned   Boolean
  photoUrl      String?
  pointsEarned  Int
  completedAt   DateTime @default(now())

  task        Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedBy User @relation(fields: [completedById], references: [id])

  @@unique([taskId, cycleNumber])
  @@index([completedById, completedAt])
}

// ============ COMPRAS Y GASTOS ============

model ShoppingItem {
  id          String   @id @default(cuid())
  householdId String
  title       String
  quantity    String?
  createdById String
  createdAt   DateTime @default(now())
  active      Boolean  @default(true) // soft delete

  // Recurrencia opcional — mismo motor que Task (computeInitialDueDate / computeNextDueDate).
  // frequency null = item de una sola vez.
  frequency   TaskFrequency?
  daysOfWeek  Int[]     @default([])
  daysOfMonth Int[]     @default([])
  nextDueDate DateTime?
  cycleNumber Int       @default(0)

  nextBuyerMembershipId String?

  // Marca "comprado" para items de una sola vez. Los recurrentes nunca quedan
  // marcados: al comprarse, avanzan de ciclo y siguen en "por comprar".
  checkedById String?
  checkedAt   DateTime?

  household Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User        @relation("itemCreator", fields: [createdById], references: [id])
  checkedBy User?       @relation("itemChecker", fields: [checkedById], references: [id])
  nextBuyer Membership? @relation("nextBuyer", fields: [nextBuyerMembershipId], references: [id])
  expenses  Expense[]

  @@index([householdId, active, checkedAt])
}

model Expense {
  id             String   @id @default(cuid())
  householdId    String
  payerId        String
  amount         Int // CLP entero
  title          String
  shoppingItemId String?
  paidAt         DateTime @default(now())

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  payer        User          @relation("payer", fields: [payerId], references: [id])
  shoppingItem ShoppingItem? @relation(fields: [shoppingItemId], references: [id])
  splits       ExpenseSplit[]

  @@index([householdId, paidAt])
}

model ExpenseSplit {
  id        String @id @default(cuid())
  expenseId String
  userId    String
  amount    Int // CLP entero, permite splits desiguales

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
}

model Settlement {
  id           String    @id @default(cuid())
  householdId  String
  fromUserId   String // quien debe
  toUserId     String // quien recibe
  amount       Int
  method       String? // Transferencia / Efectivo / Otro
  note         String?
  recordedById String // quien la registró (deudor o acreedor)
  createdAt    DateTime  @default(now())
  confirmedAt  DateTime? // null = pendiente de confirmación del otro lado

  household  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  fromUser   User      @relation("settleFrom", fields: [fromUserId], references: [id])
  toUser     User      @relation("settleTo", fields: [toUserId], references: [id])
  recordedBy User      @relation("settleRecorder", fields: [recordedById], references: [id])

  @@index([householdId, createdAt])
}

// ============ CUENTAS (GASTOS FIJOS) ============

model Room {
  id           String  @id @default(cuid())
  householdId  String
  name         String
  monthlyCost  Int
  membershipId String? @unique

  household  Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  membership Membership? @relation(fields: [membershipId], references: [id])

  @@index([householdId])
}

enum SplitMode {
  EQUAL
  CUSTOM
}

model MonthlyBill {
  id          String   @id @default(cuid())
  householdId String
  month       Int
  year        Int
  createdById String
  createdAt   DateTime @default(now())

  household Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy User            @relation("billCreator", fields: [createdById], references: [id])
  items     BillItem[]
  charges   MonthlyCharge[]

  @@unique([householdId, month, year])
}

model BillItem {
  id              String   @id @default(cuid())
  monthlyBillId   String
  label           String
  amount          Int
  splitMode       SplitMode @default(EQUAL)
  excludedUserIds String[]
  isRecurring     Boolean  @default(false)
  dayOfMonth      Int?
  createdAt       DateTime @default(now())

  monthlyBill MonthlyBill @relation(fields: [monthlyBillId], references: [id], onDelete: Cascade)
  splits      BillItemSplit[]
}

model BillItemSplit {
  id            String    @id @default(cuid())
  billItemId    String
  userId        String
  amount        Int
  paidAt        DateTime?
  confirmedAt   DateTime?
  confirmedById String?

  billItem      BillItem @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  confirmedBy   User?    @relation("billSplitConfirmer", fields: [confirmedById], references: [id])

  @@unique([billItemId, userId])
}

model MonthlyCharge {
  id                String    @id @default(cuid())
  monthlyBillId     String
  userId            String
  roomAmount        Int
  sharedAmount      Int
  totalAmount       Int
  roomPaidAt        DateTime?
  roomConfirmedAt   DateTime?
  roomConfirmedById String?

  monthlyBill       MonthlyBill @relation(fields: [monthlyBillId], references: [id], onDelete: Cascade)
  user              User        @relation("chargeOwner", fields: [userId], references: [id])
  roomConfirmedBy   User?       @relation("chargeConfirmer", fields: [roomConfirmedById], references: [id])

  @@unique([monthlyBillId, userId])
}

// ============ MURO DE AVISOS ============

model Notice {
  id          String   @id @default(cuid())
  householdId String
  authorId    String
  content     String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())

  household Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  author    User       @relation("noticeAuthor", fields: [authorId], references: [id])
  reactions Reaction[]

  @@index([householdId, createdAt])
}

model Reaction {
  id       String @id @default(cuid())
  noticeId String
  userId   String
  emoji    String

  notice Notice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id])

  @@unique([noticeId, userId, emoji])
}

// ============ PUSH ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
